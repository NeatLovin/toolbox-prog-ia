{
  "name": "toolbox-prog-ia",
  "version": "0.2.1",
  "private": true,
  "scripts": {
    "dev": "vite",
    "dev:full": "concurrently \"npm run dev\" \"npm run worker:dev\"",
    "worker:dev": "wrangler dev --local --config worker/wrangler.toml",
    "worker:deploy": "wrangler deploy --config worker/wrangler.toml",
    "prebuild": "node worker/scripts/check-event-taxonomy.mjs",
    "build": "vite build",
    "preview": "vite preview",
    "predeploy": "npm run build",
    "deploy": "gh-pages -d dist --dotfiles",
    "preflight": "node worker/scripts/preflight.mjs",
    "pilot:replay": "node worker/scripts/session-replay.mjs",
    "pilot:purge": "node worker/scripts/purge-session.mjs"
  },
  "dependencies": {
    "@fontsource-variable/geist": "^5.2.9",
    "@fontsource-variable/geist-mono": "^5.2.8",
    "pdfjs-dist": "^6.0.227",
    "pinia": "^3.0.4",
    "pinia-plugin-persistedstate": "^4.7.1",
    "vue": "^3.4.0",
    "vue-router": "^4.3.0"
  },
  "devDependencies": {
    "@vitejs/plugin-vue": "^5.0.0",
    "concurrently": "^8.2.0",
    "gh-pages": "^6.3.0",
    "playwright": "^1.61.0",
    "vite": "^8.1.0",
    "wrangler": "^4.130.0"
  }
}
